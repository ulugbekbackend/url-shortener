# Backend Environment Variables
# Copy this file to .env and update values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/linkly

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Rate Limiting
RATE_LIMIT_ANONYMOUS=100
RATE_LIMIT_USER=1000
RATE_LIMIT_API_KEY=10000

# GeoIP
GEOLITE2_PATH=/app/data/GeoLite2-City.mmdb

# Application
SHORT_DOMAIN=lnk.ly
BASE_URL=https://lnk.ly

# Blocked domains (comma-separated)
BLOCKED_DOMAINS=

# Reserved words for custom codes (comma-separated)
RESERVED_CODES=api,docs,health,login,admin,register,settings,dashboard,links,auth,static,assets

# Click processing
CLICK_BATCH_SIZE=500
CLICK_BATCH_TIMEOUT=2

# Cache TTL
LINK_CACHE_TTL=86400
NEGATIVE_CACHE_TTL=60

# Frontend Environment Variables
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

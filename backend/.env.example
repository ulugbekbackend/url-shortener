# Backend environment variables
# Copy to backend/.env and update values

# Database
# 127.0.0.1, not localhost: on Windows localhost may resolve to IPv6 ::1, which the
# Docker Desktop port relay doesn't always serve (connections then hang or reset)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/url_shortener

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Security
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Must be true in production (https); false only for local http
COOKIE_SECURE=false

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Reverse proxy: comma-separated IPs whose X-Forwarded-For header uvicorn trusts
# (the client IP drives rate limiting and analytics). Default: 127.0.0.1
# FORWARDED_ALLOW_IPS=10.0.0.5

# Rate Limiting
RATE_LIMIT_ANONYMOUS=100
RATE_LIMIT_USER=1000
RATE_LIMIT_API_KEY=10000
# Window (seconds) for the three limits above
RATE_LIMIT_WINDOW=3600
# Brute-force guards: attempts per IP per 15 minutes
RATE_LIMIT_LOGIN=10
RATE_LIMIT_UNLOCK=10
RATE_LIMIT_PASSWORD_RESET=5
# Reset emails to one address per hour
PASSWORD_RESET_EMAILS_PER_HOUR=3
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Email (SMTP) for password reset; leave SMTP_HOST empty to disable it.
# Gmail: turn on 2-Step Verification, create an App Password
# (https://myaccount.google.com/apppasswords) and use it as SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender; defaults to SMTP_USERNAME (Gmail only sends as the account or its aliases)
SMTP_FROM=
SMTP_STARTTLS=true
# Where the links in emails point to
FRONTEND_URL=http://localhost:3000

# GeoIP
GEOLITE2_PATH=./data/GeoLite2-City.mmdb

# Application
SHORT_DOMAIN=localhost:8000
BASE_URL=http://localhost:8000

# Blocked domains (comma-separated)
BLOCKED_DOMAINS=

# Reserved words for custom codes (comma-separated)
RESERVED_CODES=api,docs,health,login,admin,register,settings,dashboard,links,auth,static,assets,redoc

# Click processing
CLICK_BATCH_SIZE=500
CLICK_BATCH_TIMEOUT=2

# Cache TTL
LINK_CACHE_TTL=86400
NEGATIVE_CACHE_TTL=60

# Links created without an account expire after this many days
ANONYMOUS_LINK_TTL_DAYS=7

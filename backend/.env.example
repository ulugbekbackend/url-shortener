# Backend environment variables
# Copy to backend/.env and update values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/url_shortener

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Rate Limiting
RATE_LIMIT_ANONYMOUS=100
RATE_LIMIT_USER=1000
RATE_LIMIT_API_KEY=10000

# GeoIP
GEOLITE2_PATH=./data/GeoLite2-City.mmdb

# Application
SHORT_DOMAIN=localhost:8000
BASE_URL=http://localhost:8000

# Blocked domains (comma-separated)
BLOCKED_DOMAINS=

# Reserved words for custom codes (comma-separated)
RESERVED_CODES=api,docs,health,login,admin,register,settings,dashboard,links,auth,static,assets,redoc

# Click processing
CLICK_BATCH_SIZE=500
CLICK_BATCH_TIMEOUT=2

# Cache TTL
LINK_CACHE_TTL=86400
NEGATIVE_CACHE_TTL=60
